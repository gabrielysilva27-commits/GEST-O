{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lead-gestao",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Presence"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
